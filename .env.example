# Copy to .env and adjust. Every variable is optional; the values below are the defaults
# unless noted. Never commit your real .env.

# ---------- LLM (question writing and free-form grading) ----------
# ollama | gemini | openai_compatible | none
#   gemini: Google's native Gemini API (free tier). Get a key at aistudio.google.com;
#   set LLM_MODEL to a model your key can use, e.g. gemini-3.8-flash. LLM_BASE_URL is not needed.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434
# Only needed for hosted openai_compatible APIs (e.g. https://api.openai.com/v1, https://api.groq.com/openai/v1)
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_EVAL_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# Optional: less "thinking" = faster questions on reasoning models.
#   gemini: low or high (Gemini 3 models) | openai_compatible: e.g. low | ollama: none
LLM_REASONING_EFFORT=
# gemini only: comma-separated models to try when the main one is overloaded (HTTP 503/429)
LLM_FALLBACK_MODELS=
# If the LLM is unreachable, keep going with questions built directly from document sentences.
LLM_FALLBACK_TO_EXTRACTIVE=true

# ---------- Embeddings ----------
# hash (built-in, no download, lexical) | ollama | openai_compatible | sentence_transformers
EMBEDDING_PROVIDER=hash
# Used by ollama / openai_compatible / sentence_transformers, e.g. nomic-embed-text or all-MiniLM-L6-v2
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# ---------- Chunking & retrieval ----------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=80
VECTOR_STORE=numpy
RETRIEVAL_TOP_K=4
RETRIEVAL_CANDIDATE_MULTIPLIER=3
RETRIEVAL_HYBRID_ALPHA=0.7
MAX_CONTEXT_CHARS=6000

# ---------- Adaptive learning ----------
START_DIFFICULTY=easy
ADAPTIVE_WINDOW=3
ADAPTIVE_MIN_ANSWERS=2
ADAPTIVE_PROMOTE_THRESHOLD=0.8
ADAPTIVE_DEMOTE_THRESHOLD=0.4

# ---------- Limits & storage ----------
MAX_UPLOAD_MB=25
MAX_PAGES=500
MAX_GENERATION_ATTEMPTS=4
# Defaults to backend/data
# DATA_DIR=
DEBUG=false
